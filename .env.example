# Database and application signing secret.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_bots
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Provider credentials.
SARVAM_API_KEY=
ATTENDEE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MEETING_BOT_EMAIL=
# Generate: uv run python -m app.core.meeting_google keygen
# Keep stable and backed up separately from the database.
MEETING_TOKEN_KEY=

# Deployment-specific access and network configuration.
MEETING_OPERATOR_USER_IDS=[]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Public HTTPS origin of this backend for Attendee audio callbacks.
MEETING_PUBLIC_BACKEND_URL=
# STUN/TURN servers; may include deployment credentials.
ICE_SERVERS=[]

# Models, voice, limits, timing, prompts, and catalogs:
# app/constants/constants.py
