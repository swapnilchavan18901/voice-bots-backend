# Copy this file to .env in bots-backend. Leave unused provider settings blank.
# Lists (CORS_ORIGINS, MEETING_OPERATOR_USER_IDS, ICE_SERVERS) use JSON syntax.

# Core application: required for normal backend operation.
# Matches the local PostgreSQL service in compose.yaml.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_bots
# Generate: uv run python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Replace this placeholder; keep stable across restarts (also signs Outreach URLs).
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI voice: required for clinic, general conversation, meetings, and sales calls.
SARVAM_API_KEY=

# Browser voice: optional deployment-specific STUN/TURN configuration.
# Example: [{"urls":["turn:turn.example.com:3478"],"username":"replace-me","credential":"replace-me"}]
ICE_SERVERS=[]

# Meetings: Attendee joins Google Meet and bridges participant audio.
ATTENDEE_API_KEY=
# Public HTTPS origin of this backend for Attendee audio callbacks.
# Example: https://api.example.com (must support WebSocket upgrades).
MEETING_PUBLIC_BACKEND_URL=

# Meetings: shared Google Calendar connection (operator-managed).
# Use Google OAuth Desktop app credentials for the CLI loopback flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google account whose primary calendar is connected by the operator.
MEETING_BOT_EMAIL=
# Generate: uv run python -m app.core.meeting_google keygen
# Encrypts stored Google tokens; keep stable and backed up separately from the database.
MEETING_TOKEN_KEY=
# Dashboard user UUIDs allowed to perform platform meeting-operator actions.
# Example: ["00000000-0000-0000-0000-000000000001"]
MEETING_OPERATOR_USER_IDS=[]
# After configuring Google credentials and the encryption key:
# uv run python -m app.core.meeting_google connect

# Sia Outreach: Exotel Connect Voice AI / AgentStream must be enabled on the account.
# Required to run sales campaigns; drafts can be created without these credentials.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# Your Exotel ExoPhone / virtual number used as the outbound caller ID.
EXOTEL_CALLER_ID=
# India: api.in.exotel.com; Singapore: api.exotel.com
EXOTEL_API_HOST=api.in.exotel.com
# Public HTTPS origin of this backend for media streams and status callbacks.
# Must support WebSocket upgrades; can match MEETING_PUBLIC_BACKEND_URL.
OUTREACH_PUBLIC_BACKEND_URL=

# Clinic inbound/outbound phone calls: uses the shared EXOTEL_* credentials above.
# Public HTTPS backend origin with WebSocket upgrades; can match the other public URLs.
# Inbound calls also require an Exotel number routed to a Voicebot applet (docs/clinic-phone.md).
CLINIC_PUBLIC_BACKEND_URL=
# Trusted dashboard user UUIDs allowed to allocate inbound numbers; also need
# owner/admin membership in the destination workspace. Outbound calls need owner/admin only.
CLINIC_OPERATOR_USER_IDS=[]

# Models, voice, limits, timing, prompts, and catalogs:
# app/constants/constants.py
