# Existing app requirements (set your own values)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_bots
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Operator-owned Google account, Desktop OAuth client; no customer OAuth connections.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MEETING_BOT_EMAIL=
# Generate locally: uv run python -m app.core.meeting_google keygen
# Keep this key stable and backed up separately from the database.
MEETING_TOKEN_KEY=
MEETING_SYNC_DAYS=30
# Dashboard users allowed to view the shared calendar inbox. Use existing USER UUIDs,
# not email addresses or organization roles; empty means no dashboard operator.
MEETING_OPERATOR_USER_IDS=[]
# Dashboard browser origins for direct bearer-authenticated requests.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Attendee meeting voice agent (replaces the browser joining worker).
ATTENDEE_API_KEY=
ATTENDEE_API_URL=https://app.attendee.dev
# Public HTTPS origin of THIS backend; Attendee opens a WebSocket to it.
# Local example: https://your-tunnel.ngrok-free.app (forward tunnel to port 8000).
MEETING_PUBLIC_BACKEND_URL=
MEETING_VOICE_NAME=Sia
MEETING_VOICE_LANGUAGE=en-IN
MEETING_VOICE_SECONDS=14400
# Attendee leaves after the bot is alone for this many seconds.
MEETING_EMPTY_LEAVE_SECONDS=30
MEETING_VOICE_MAX_PARTICIPANTS=30
# Speak one short filler if a meeting answer takes longer than this; 0 disables it.
MEETING_FILLER_DELAY_MS=700

# Shared voice provider and WebRTC limits
SARVAM_API_KEY=
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_VOICE=shubh
ACCESS_TOKEN_MINUTES=60
ICE_SERVERS=[]
MAX_VOICE_SESSIONS=20
VOICE_SESSION_SECONDS=1800
